<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        이 앱은 별도의 위험 권한(인터넷, 저장소, 알림 게시 등)을 요청하지 않는다.
        - 알림 수집: 사용자가 시스템 설정에서 직접 "알림 접근"을 허용해야 한다.
        - 내보내기: SAF(문서 생성)를 사용하므로 저장소 권한이 필요 없다.
        - INTERNET 권한이 없으므로 데이터가 네트워크로 전송될 수 없다.
    -->

    <!-- Android 11+ 패키지 공개 범위: 런처에 표시되는 앱 목록/아이콘/실행만 조회한다. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".NotificationLogApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.NotificationLog"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.NotificationLog">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 알림 수신 서비스: 시스템만 바인딩할 수 있도록 BIND_NOTIFICATION_LISTENER_SERVICE 로 보호한다. -->
        <service
            android:name=".service.NotificationLogListenerService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
